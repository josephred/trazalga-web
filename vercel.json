{
    "rewrites": [
        {
            "source": "/v-api/:path*",
            "destination": "/api/proxy?path=:path*"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/proxy?path=:path*"
        },
        {
            "source": "/((?!api/|assets/|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}