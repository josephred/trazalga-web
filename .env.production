# Origen del backend para builds de producción (npm run build).
# Las llamadas al API van directas al backend (que envía cabeceras CORS),
# sin depender de un proxy en el hosting (necesario en cPanel/zya.me, donde el
# proxy .htaccess/proxy.php no funciona por las restricciones del host gratuito).
# En desarrollo (npm run dev) NO se usa este archivo: se usa el proxy de Vite.
VITE_API_URL=https://apps.procesac.com
